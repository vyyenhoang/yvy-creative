---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Gallery from '../../components/Gallery.astro';
import { getProjects, onColor, pad, url, type Project } from '../../lib/utils';
import { autoLayout, getChapterFolders, getProjectMedia, prettify, type MediaItem } from '../../lib/media';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  index: number;
  next: Project;
}

const { project, index, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const media = getProjectMedia(project.id);
const nextMedia = getProjectMedia(next.id);
const brand = d.color;
const onBrand = onColor(brand);
const isDev = import.meta.env.DEV;

// Build chapters: the ones described in project.md first (in that order), then any other folders found on disk.
type Ch = (typeof d.chapters)[number] & { items: MediaItem[]; folderPath?: string };
const described = new Set(d.chapters.map((c) => c.folder).filter(Boolean));
const chapters: Ch[] = [
  ...d.chapters.map((c) => ({ ...c, items: c.folder ? (media.chapters.get(c.folder) ?? []) : [] })),
  ...getChapterFolders(project.id)
    .filter((f) => !described.has(f))
    .map((f) => ({
      folder: f,
      layout: 'auto' as const,
      pills: [],
      steps: [],
      swatches: [],
      typefaces: [],
      captions: false,
      items: media.chapters.get(f) ?? [],
    })),
  ...(media.loose.length
    ? [
        {
          folder: undefined,
          title: 'More work',
          layout: 'auto' as const,
          pills: [],
          steps: [],
          swatches: [],
          typefaces: [],
          captions: false,
          items: media.loose,
        },
      ]
    : []),
].filter((c) => {
  const hasExtras = c.text || c.pills.length || c.steps.length || c.swatches.length || c.typefaces.length;
  if (c.items.length) return true;
  if (!c.folder) return Boolean(hasExtras); // text-only chapter
  return isDev; // empty folder → placeholder while developing, hidden on the live site
});

const ogImage =
  media.cover?.kind === 'image' ? (await getImage({ src: media.cover.image, width: 1200, format: 'jpg' })).src : undefined;

const meta = [
  { label: 'Role', value: d.role + (d.type ? ` · ${d.type}` : '') },
  { label: 'Timeline', value: d.year },
  ...(d.industry ? [{ label: 'Industry', value: d.industry }] : []),
  ...(d.services.length ? [{ label: 'Deliverables', value: d.services.join(', ') }] : []),
];
---

<Base title={d.title} description={d.summary} brand={brand} onBrand={onBrand} image={ogImage}>
  <!-- HERO -->
  <section class="cs-hero wrap">
    <div class="cs-crumbs" data-reveal>
      <a href={url('/#work')}>← All work</a>
      <span>Case study {pad(index + 1)}</span>
      {isDev && d.draft && <span class="draft-flag">Draft · hidden on live site</span>}
    </div>
    <p class="eyebrow cs-cat" data-reveal>{d.category}</p>
    <h1 class="display cs-title" data-reveal>{d.title}</h1>
    <p class="cs-tagline serif" data-reveal style="--d:.1s">{d.tagline}</p>

    <dl class="cs-meta" data-reveal style="--d:.18s">
      {
        meta.map((m) => (
          <div>
            <dt class="eyebrow">{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="wrap">
    <div class="cs-cover" data-reveal>
      <Cover
        title={d.title}
        category={d.category}
        year={d.year}
        index={index + 1}
        cover={media.cover}
        logo={media.logo}
        sizes="(min-width: 1480px) 1380px, 94vw"
        eager
        big
      />
    </div>
  </div>

  <!-- OVERVIEW -->
  <section class="section">
    <div class="wrap grid-12">
      <div class="side-label" data-reveal>
        <span class="eyebrow">(01) Overview</span>
      </div>
      <div class="cs-overview">
        <p class="cs-summary" data-reveal>{d.summary}</p>
        <div class="prose" data-reveal><Content /></div>
        {
          d.website || d.links.length ? (
            <div class="chips cs-links" data-reveal>
              {d.website && (
                <a class="btn btn-ghost" href={d.website} target="_blank" rel="noopener">
                  Visit {new URL(d.website).hostname.replace('www.', '')} <span class="arrow">↗</span>
                </a>
              )}
              {d.links.map((l) => (
                <a class="btn btn-ghost" href={l.url} target="_blank" rel="noopener">
                  {l.label} <span class="arrow">↗</span>
                </a>
              ))}
            </div>
          ) : null
        }
      </div>
    </div>

    {
      d.stats.length > 0 && (
        <div class="wrap">
          <div class="cs-stats">
            {d.stats.map((s, i) => (
              <div class="cs-stat" data-reveal style={`--d:${i * 0.06}s`}>
                <span class="cs-stat-value" data-count={s.value}>
                  {s.value}
                </span>
                <span class="cs-stat-label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>

  <!-- THINKING -->
  {
    (d.thinking.length > 0 || d.keywords.length > 0) && (
      <section class="section thinking">
        <div class="wrap">
          <header class="thinking-head">
            <span class="eyebrow">(02) Thinking process</span>
            <h2 class="h2" data-reveal>
              Before the pixels, <em>the why.</em>
            </h2>
          </header>
          <div class="thinking-grid">
            {d.thinking.map((t, i) => (
              <article class="think" data-reveal style={`--d:${i * 0.08}s`}>
                <span class="think-no">{pad(i + 1)}</span>
                <p class="eyebrow">{t.label}</p>
                {t.title && <h3 class="h3">{t.title}</h3>}
                <p class="think-text">{t.text}</p>
              </article>
            ))}
          </div>
          {d.keywords.length > 0 && (
            <div class="keywords" data-reveal>
              <span class="eyebrow">The brand should feel</span>
              <p>
                {d.keywords.map((k, i) => (
                  <>
                    <span class:list={['kw', i % 2 === 1 && 'serif']}>{k}</span>
                    {i < d.keywords.length - 1 && <span class="kw-dot">✳</span>}
                  </>
                ))}
              </p>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- PROCESS -->
  {
    d.process.length > 0 && (
      <section class="section">
        <div class="wrap">
          <header class="row-head">
            <span class="eyebrow">(03) Process</span>
            <h2 class="h2" data-reveal>
              How it <em>came together</em>
            </h2>
          </header>
          <ol class="flow" style={`--n:${d.process.length}`}>
            {d.process.map((s, i) => (
              <li data-reveal style={`--d:${i * 0.07}s`}>
                <span class="flow-no">{pad(i + 1)}</span>
                <h3 class="flow-title">{s.title}</h3>
                {s.text && <p class="muted">{s.text}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- CHAPTERS: one per folder of designs -->
  {
    chapters.map((c, i) => {
      const title = c.title ?? (c.folder ? prettify(c.folder) : 'More work');
      const layout = c.layout === 'auto' ? autoLayout(c.items) : c.layout;
      return (
        <section class="section chapter" id={c.folder ?? 'more-work'}>
          <div class="wrap">
            <header class="ch-head">
              <span class="ch-no" data-reveal>
                {pad(i + 1)}
              </span>
              <div class="ch-body">
                {c.kicker && (
                  <p class="eyebrow" data-reveal>
                    {c.kicker}
                  </p>
                )}
                <h2 class="h2" data-reveal>
                  {title}
                </h2>
                {c.text && (
                  <p class="lead ch-text" data-reveal>
                    {c.text}
                  </p>
                )}
                {c.pills.length > 0 && (
                  <div class="chips ch-pills" data-reveal>
                    {c.pills.map((p) => (
                      <span class="chip">{p}</span>
                    ))}
                  </div>
                )}
                {c.steps.length > 0 && (
                  <ol class="mini-flow" data-reveal>
                    {c.steps.map((s, k) => (
                      <li>
                        <span>{pad(k + 1)}</span>
                        {s}
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            </header>

            {c.swatches.length > 0 && (
              <div class="swatch-row" data-reveal>
                {c.swatches.map((s) => (
                  <div class="swatch" style={`--c:${s.hex};--on:${onColor(s.hex)}`}>
                    <span class="swatch-name">{s.name}</span>
                    <span class="swatch-hex">{s.hex.toUpperCase()}</span>
                  </div>
                ))}
              </div>
            )}

            {c.typefaces.length > 0 && (
              <div class="type-row" data-reveal>
                {c.typefaces.map((t) => (
                  <div class="typeface">
                    <span class="tf-aa">Aa</span>
                    <span class="tf-name">{t.name}</span>
                    {t.role && <span class="muted">{t.role}</span>}
                  </div>
                ))}
              </div>
            )}

            {c.items.length > 0 ? (
              <Gallery
                items={c.items}
                layout={layout}
                columns={c.columns}
                group={c.folder ?? 'more'}
                alt={`${d.title} — ${title}`}
                captions={c.captions}
              />
            ) : (
              isDev &&
              c.folder && (
                <div class="dropzone">
                  <p>
                    <strong>Drop designs here →</strong> <code>projects/{project.id}/{c.folder}/</code>
                  </p>
                  <p class="muted">
                    JPG / PNG / WEBP / GIF / SVG / MP4. Name files 01-…, 02-… to set the order. This box only shows on your
                    computer — empty chapters are hidden on the live site.
                  </p>
                  <div class="dropzone-tiles" aria-hidden="true">
                    {Array.from({ length: 8 }, () => (
                      <span />
                    ))}
                  </div>
                </div>
              )
            )}
          </div>
        </section>
      );
    })
  }

  <!-- RESULTS -->
  {
    d.results && d.results.metrics.length > 0 && (
      <section class="results">
        <div class="wrap">
          <header class="results-head">
            <span class="eyebrow">Results</span>
            <h2 class="h2" data-reveal>
              {d.results.title ?? 'What it achieved'}
            </h2>
            {d.results.intro && (
              <p class="lead" data-reveal>
                {d.results.intro}
              </p>
            )}
          </header>
          <div class="metrics">
            {d.results.metrics.map((m, i) => (
              <div class="metric" data-reveal style={`--d:${i * 0.08}s`}>
                <span class="metric-value" data-count={m.value}>
                  {m.value}
                </span>
                <span class="metric-label">{m.label}</span>
                {m.detail && <span class="metric-detail">{m.detail}</span>}
              </div>
            ))}
          </div>
          {d.results.quote && (
            <blockquote class="quote" data-reveal>
              <p class="serif">“{d.results.quote.text}”</p>
              {d.results.quote.by && <cite>— {d.results.quote.by}</cite>}
            </blockquote>
          )}
        </div>
      </section>
    )
  }

  <!-- TOOLKIT -->
  {
    d.tools.length > 0 && (
      <section class="section toolkit">
        <div class="wrap grid-12">
          <div class="side-label">
            <span class="eyebrow">Toolkit</span>
          </div>
          <div class="chips tools" data-reveal>
            {d.tools.map((t) => (
              <span class="chip">{t}</span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- NEXT -->
  {
    next.id !== project.id && (
      <a class="next" href={url(`/work/${next.id}/`)} style={`--brand:${next.data.color};--on-brand:${onColor(next.data.color)}`}>
        <div class="wrap next-inner">
          <div>
            <span class="eyebrow">Next case study</span>
            <p class="display next-title">{next.data.title}</p>
            <p class="next-cat">{next.data.category} →</p>
          </div>
          <div class="next-thumb">
            <Cover
              title={next.data.title}
              category={next.data.category}
              year={next.data.year}
              index={((index + 1) % 99) + 1}
              cover={nextMedia.cover}
              logo={nextMedia.logo}
              sizes="(min-width: 900px) 30vw, 60vw"
            />
          </div>
        </div>
      </a>
    )
  }
</Base>

<style>
  /* HERO */
  .cs-hero {
    padding-top: clamp(20px, 3vw, 40px);
    padding-bottom: clamp(36px, 4vw, 56px);
  }
  .cs-crumbs {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .cs-crumbs a:hover {
    color: var(--ink);
  }
  .draft-flag {
    background: #ffe27a;
    color: var(--ink);
    padding: 2px 10px;
    border-radius: 999px;
  }
  .cs-cat {
    margin-top: clamp(32px, 5vw, 64px);
    color: color-mix(in srgb, var(--brand) 78%, var(--ink));
  }
  .cs-title {
    margin-top: 14px;
    font-size: clamp(3rem, 10vw, 10rem);
    text-wrap: balance;
  }
  .cs-tagline {
    margin-top: 22px;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    max-width: 30ch;
    color: var(--ink-2);
  }
  .cs-meta {
    margin: clamp(32px, 4vw, 56px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px 32px;
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }
  .cs-meta dd {
    margin: 8px 0 0;
    font-weight: 500;
    line-height: 1.45;
  }
  @media (max-width: 860px) {
    .cs-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cs-cover {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 8.5;
    min-height: 320px;
  }
  @media (max-width: 640px) {
    .cs-cover {
      aspect-ratio: 4 / 5;
    }
  }

  /* SIDE LABEL + OVERVIEW */
  .side-label {
    grid-column: 1 / span 3;
    padding-top: 10px;
  }
  .cs-overview {
    grid-column: 4 / span 9;
    display: grid;
    gap: 28px;
  }
  .cs-summary {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 520;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }
  .cs-links {
    gap: 10px;
  }
  @media (max-width: 860px) {
    .side-label,
    .cs-overview {
      grid-column: 1 / -1;
    }
  }
  .cs-stats {
    margin-top: clamp(48px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .cs-stat {
    padding: 26px 22px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cs-stat-value {
    font-family: var(--f-display);
    font-weight: 640;
    font-size: clamp(2.4rem, 4.6vw, 4.2rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: color-mix(in srgb, var(--brand) 88%, var(--ink));
    font-variant-numeric: tabular-nums;
  }
  .cs-stat-label {
    color: var(--muted);
    max-width: 24ch;
  }

  /* THINKING */
  .thinking {
    background: var(--ink);
    color: var(--paper);
  }
  .thinking .eyebrow {
    color: rgba(244, 240, 232, 0.6);
  }
  .thinking-head {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .thinking-head em,
  .kw-dot {
    color: color-mix(in srgb, var(--brand) 50%, #fff);
  }
  .thinking-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  .think {
    position: relative;
    padding: clamp(22px, 2.6vw, 36px);
    border: 1px solid rgba(244, 240, 232, 0.16);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .think-no {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 5rem;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 240, 232, 0.35);
  }
  .think .h3 {
    color: var(--paper);
  }
  .think-text {
    color: rgba(244, 240, 232, 0.78);
  }
  .keywords {
    margin-top: clamp(48px, 6vw, 88px);
    padding-top: 28px;
    border-top: 1px solid rgba(244, 240, 232, 0.16);
  }
  .keywords p {
    margin-top: 14px;
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 5.4vw, 5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    overflow-wrap: break-word;
  }
  .kw-dot {
    font-size: 0.5em;
    vertical-align: middle;
    margin-inline: 0.3em;
  }

  /* PROCESS FLOW */
  .row-head {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(36px, 4.4vw, 64px);
  }
  .flow {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 0;
  }
  .flow li {
    position: relative;
    padding: 30px 20px 0 0;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .flow li::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand);
  }
  .flow-no {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .flow-title {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .flow .muted {
    font-size: 15px;
  }
  @media (max-width: 960px) {
    .flow {
      grid-template-columns: 1fr;
    }
    .flow li {
      border-top: 0;
      border-left: 2px solid var(--ink);
      padding: 0 0 28px 28px;
    }
    .flow li::before {
      top: 0;
      left: -8px;
    }
  }

  /* CHAPTERS */
  .chapter + .chapter {
    padding-top: 0;
  }
  .chapter + .chapter .ch-head {
    padding-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--line-strong);
  }
  .ch-head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 24px clamp(16px, 2.2vw, 32px);
  }
  .ch-no {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--brand);
  }
  .ch-body {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .ch-text {
    max-width: 58ch;
  }
  .ch-pills {
    margin-top: 6px;
  }
  .mini-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .mini-flow li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 8px;
    border-radius: 999px;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 14px;
    font-weight: 600;
  }
  .mini-flow li span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--on-brand);
    color: var(--brand);
    font-size: 11px;
  }
  .mini-flow li:not(:last-child)::after {
    content: '→';
    margin-left: 4px;
    opacity: 0.7;
  }
  @media (max-width: 760px) {
    .ch-head {
      grid-template-columns: 1fr;
    }
  }

  .swatch-row {
    margin-top: clamp(32px, 4vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }
  .swatch {
    aspect-ratio: 1 / 1.1;
    border-radius: var(--radius-sm);
    background: var(--c);
    color: var(--on);
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    border: 1px solid var(--line);
  }
  .swatch-name {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.2rem;
  }
  .swatch-hex {
    font-size: 13px;
    opacity: 0.8;
    letter-spacing: 0.06em;
  }
  .type-row {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .typeface {
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tf-aa {
    font-family: var(--f-display);
    font-size: 4.4rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .tf-name {
    font-weight: 600;
  }

  /* RESULTS */
