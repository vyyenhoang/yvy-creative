---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { site } from '../site.config';
import { getProjects, onColor, pad, url } from '../lib/utils';
import { getProjectMedia } from '../lib/media';

const projects = await getProjects();

// Optional portrait: drop about/portrait.jpg (or .png / .webp)
const portraits = import.meta.glob<{ default: ImageMetadata }>('/about/portrait.{jpg,jpeg,png,webp,JPG,PNG}', {
  eager: true,
});
const portrait = Object.values(portraits)[0]?.default;

// Card rhythm on desktop: wide/narrow, narrow/wide …
const span = (i: number) => ([0, 3].includes(i % 4) ? 'wide' : 'narrow');

const marquee = ['Branding', 'Creative Design', 'Social Media', 'Content Creation', 'Paid Ads', 'Video & Motion', 'Print', 'Packaging'];

const process = [
  { title: 'Discover', text: 'Audience, competitors and business goals — what does this brand need to be known for?' },
  { title: 'Define', text: 'Turn research into one clear insight, a creative direction and content pillars.' },
  { title: 'Design', text: 'Concepts, iterations and honest feedback loops until the idea is unmistakable.' },
  { title: 'Deliver', text: 'Production across social, paid, print and web — on brand, on time, at volume.' },
  { title: 'Measure', text: 'Track what moved: reach, engagement, conversion. Then do more of what works.' },
];
---

<Base>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-top" data-reveal>
      <span class="avail"><span class="dot-live"></span> Open to full-time creative roles</span>
      <span class="hide-sm">{site.role}</span>
      <span>{site.location}</span>
    </div>

    <div class="hero-head">
    <h1 class="display hero-title">
      <span class="line" data-reveal>Brands,</span>
      <span class="line indent" data-reveal style="--d:.08s">
        content
        <span class="swatches" aria-hidden="true">
          {projects.map((p) => <i style={`background:${p.data.color}`} />)}
        </span>
        &amp;
      </span>
      <span class="line" data-reveal style="--d:.16s">stories people <em>remember.</em></span>
    </h1>
    <a class="badge" href="#work" aria-hidden="true" tabindex="-1">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <defs><path id="circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
        <text><textPath href="#circle">BRANDING ✳ DESIGN ✳ SOCIAL ✳ CONTENT ✳ </textPath></text>
      </svg>
      <span class="badge-arrow">↓</span>
    </a>
    </div>

    <div class="hero-bottom grid-12">
      <p class="lead hero-intro" data-reveal style="--d:.24s">{site.intro}</p>
      <ol class="hero-disc" data-reveal style="--d:.3s">
        {
          site.disciplines.map((d, i) => (
            <li>
              <span class="muted">({pad(i + 1)})</span> {d.title}
            </li>
          ))
        }
      </ol>
      <div class="hero-cta" data-reveal style="--d:.36s">
        <a class="btn btn-solid" href="#work">See the work <span class="arrow">↓</span></a>
        <a class="btn btn-ghost" href={site.resume} target="_blank" rel="noopener">Résumé <span class="arrow">↗</span></a>
      </div>
    </div>

  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {marquee.map((m) => (
              <>
                <span class="marquee-item">{m}</span>
                <span class="marquee-star">✳</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- WORK -->
  <section class="section" id="work">
    <div class="wrap">
      <header class="sec-head">
        <h2 class="h2" data-reveal>Selected <em>work</em> <sup class="count">({pad(projects.length)})</sup></h2>
        <p class="lead" data-reveal style="--d:.1s">
          {projects.length} brands, from home security to crochet. Each case study walks through the brief, the thinking
          behind it and what it achieved.
        </p>
      </header>

      <div class="work-grid">
        {
          projects.map((p, i) => {
            const m = getProjectMedia(p.id);
            const hasResults = (p.data.results?.metrics.length ?? 0) > 0;
            return (
              <a
                class:list={['card', span(i)]}
                href={url(`/work/${p.id}/`)}
                style={`--brand:${p.data.color};--on-brand:${onColor(p.data.color)}`}
                data-reveal
              >
                <div class="card-media">
                  <Cover
                    title={p.data.title}
                    category={p.data.category}
                    year={p.data.year}
                    index={i + 1}
                    cover={m.cover}
                    logo={m.logo}
                    sizes={span(i) === 'wide' ? '(min-width: 900px) 58vw, 94vw' : '(min-width: 900px) 40vw, 94vw'}
                    eager={i < 2}
                  />
                  <span class="card-cta">View case study ↗</span>
                </div>
                <div class="card-meta">
                  <span class="card-no">{pad(i + 1)}</span>
                  <div>
                    <h3 class="h3 card-title">{p.data.title}</h3>
                    <p class="card-cat">{p.data.category}</p>
                    {(hasResults || p.data.draft) && (
                      <p class="card-flags">
                        {hasResults && <span class="card-badge">↗ Results inside</span>}
                        {p.data.draft && <span class="card-badge draft">Draft — hidden when live</span>}
                      </p>
                    )}
                  </div>
                  <span class="card-year">{p.data.year}</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="wrap stats-grid">
      {
        site.stats.map((s, i) => (
          <div class="stat" data-reveal style={`--d:${i * 0.08}s`}>
            <span class="stat-value" data-count={s.value}>
              {s.value}
            </span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="wrap">
      <header class="sec-head">
        <h2 class="h2" data-reveal>What I <em>do</em></h2>
        <p class="lead" data-reveal style="--d:.1s">
          Four disciplines, one goal: make the brand easy to recognise, easy to trust and hard to scroll past.
        </p>
      </header>
      <div class="services">
        {
          site.disciplines.map((d, i) => (
            <article class="service" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="service-no">({pad(i + 1)})</span>
              <h3 class="h3">{d.title}</h3>
              <p class="muted">{d.text}</p>
              <ul>
                {d.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process-sec">
    <div class="wrap">
      <header class="sec-head">
        <h2 class="h2" data-reveal>How I <em>think</em></h2>
        <p class="lead" data-reveal style="--d:.1s">
          Every project — a logo, a month of posts or a paid campaign — goes through the same five moves.
        </p>
      </header>
      <ol class="process">
        {
          process.map((s, i) => (
            <li data-reveal style={`--d:${i * 0.08}s`}>
              <span class="p-no">{pad(i + 1)}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ABOUT + RECOGNITION -->
  <section class="section about" id="about">
    <div class="wrap grid-12">
      <div class="about-media" data-reveal>
        {
          portrait ? (
            <Image src={portrait} alt={`Portrait of ${site.name}`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 34vw, 94vw" />
          ) : (
            <div class="about-mono" aria-hidden="true">
              <span>Y</span>
              <span class="serif">Vy</span>
            </div>
          )
        }
      </div>
      <div class="about-body">
        <h2 class="h2" data-reveal>Hi, I’m <em>Y Vy.</em></h2>
        <div class="prose about-text" data-reveal style="--d:.1s">
          <p>
            I’m a multimedia designer in Toronto who lives at the intersection of <strong>brand, content and results</strong>.
            I’ve designed for home-security and senior-care companies, built a crochet-learning startup from the ground up as
            co-founder, and grown an e-bike brand’s Instagram from zero to 11K+.
          </p>
          <p>
            I care about the thinking as much as the pixels: who the audience is, what they need to believe, and how every
            post, ad and package moves them one step closer.
          </p>
        </div>

        <h3 class="eyebrow sub" data-reveal>Recognition</h3>
        <ul class="list" data-reveal>
          {
            site.awards.map((a) => (
              <li>
                <span class="list-date">{a.date}</span>
                <span>
                  <strong>{a.title}</strong>
                  <span class="muted"> — {a.detail}</span>
                </span>
                <span class="list-meta muted">{a.issuer}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="eyebrow sub" data-reveal>Education</h3>
        <ul class="list" data-reveal>
          {
            site.education.map((e) => (
              <li>
                <span class="list-date">{e.years}</span>
                <strong>{e.program}</strong>
                <span class="list-meta muted">{e.school}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Hiring a designer? Let’s talk.</p>
      <h2 class="display contact-title" data-reveal>
        Let’s make something people <em>remember.</em>
      </h2>
      <a class="contact-mail" href={`mailto:${site.email}`} data-reveal>{site.email} <span class="arrow">↗</span></a>
      <div class="contact-links" data-reveal>
        {
          site.links.map((l) => (
            <a class="btn btn-ghost" href={l.url} target="_blank" rel="noopener">
              {l.label} <span class="arrow">↗</span>
            </a>
          ))
        }
        <a class="btn btn-ghost" href={site.resume} target="_blank" rel="noopener">Résumé (PDF) <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    padding-top: clamp(28px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 500;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-strong);
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  @media (max-width: 640px) {
    .hide-sm {
      display: none;
    }
  }
  .hero-title {
    margin-top: clamp(28px, 5vw, 64px);
    display: flex;
    flex-direction: column;
  }
  .hero-title .indent {
    padding-left: clamp(0px, 12vw, 220px);
    display: flex;
    align-items: center;
    gap: 0.18em;
    flex-wrap: wrap;
  }
  .swatches {
    display: inline-flex;
    align-items: center;
    padding: 0.1em 0.16em;
    border: 1px solid var(--ink);
    border-radius: 999px;
    height: 0.62em;
    margin-inline: 0.04em;
  }
  .swatches i {
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    margin-left: -0.09em;
    border: 2px solid var(--paper);
  }
  .swatches i:first-child {
    margin-left: 0;
  }
  .hero-title em {
    color: var(--accent);
  }
  .hero-bottom {
    margin-top: clamp(36px, 5vw, 72px);
    align-items: start;
  }
  .hero-intro {
    grid-column: 1 / span 5;
  }
  .hero-disc {
    grid-column: 7 / span 3;
    font-family: var(--f-display);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.75;
  }
  .hero-cta {
    grid-column: 10 / span 3;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .hero-head {
    position: relative;
  }
  .badge {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(92px, 11vw, 160px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
  }
  @media (max-width: 640px) {
    .badge {
      display: none;
    }
  }
  .badge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 18s linear infinite;
  }
  .badge text {
    font-family: var(--f-body);
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    fill: currentColor;
  }
  .badge-arrow {
    font-size: 1.8rem;
    transition: transform 0.4s var(--ease);
  }
  .badge:hover .badge-arrow {
    transform: translateY(4px);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 960px) {
    .hero-intro {
      grid-column: 1 / -1;
    }
    .hero-disc {
      grid-column: 1 / span 6;
    }
    .hero-cta {
      grid-column: 7 / span 6;
    }
  }
  @media (max-width: 560px) {
    .hero-disc,
    .hero-cta {
      grid-column: 1 / -1;
    }
    .hero-cta {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  /* SECTION HEAD */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 24px 48px;
    align-items: end;
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(32px, 4vw, 56px);
    border-bottom: 1px solid var(--line-strong);
  }
  .sec-head .lead {
    max-width: 46ch;
  }
  .count {
    font-family: var(--f-body);
    font-size: 0.28em;
    font-weight: 500;
    letter-spacing: 0;
    vertical-align: super;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .sec-head {
      grid-template-columns: 1fr;
    }
  }

  /* WORK GRID */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 80px) clamp(16px, 2.2vw, 32px);
    align-items: end;
  }
  .card {
    display: block;
    grid-column: span 5;
  }
  .card.wide {
    grid-column: span 7;
  }
  .card-media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 0.86;
    background: var(--brand);
    transform: translateZ(0);
  }
  .card.wide .card-media {
    aspect-ratio: 1.2;
  }
  .card:hover .card-media :global(img) {
    transform: scale(1.04);
  }
  .card-cta {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    scale: 0.8;
    opacity: 0;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
    transition:
      opacity 0.35s var(--ease),
      scale 0.35s var(--ease);
  }
  .card:hover .card-cta,
  .card:focus-visible .card-cta {
    opacity: 1;
    scale: 1;
  }
  .card-flags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .card-badge {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 12px;
    font-weight: 600;
  }
  .card-badge.draft {
    background: #ffe27a;
    color: var(--ink);
  }
  .card-meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding-top: 18px;
  }
  .card-no {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .card-title {
    transition: color 0.3s;
  }
  .card:hover .card-title {
    color: color-mix(in srgb, var(--brand) 85%, var(--ink));
  }
  .card-cat {
    color: var(--muted);
    font-size: 15px;
    margin-top: 4px;
  }
  .card-year {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .card,
    .card.wide {
      grid-column: 1 / -1;
    }
    .card-media,
    .card.wide .card-media {
      aspect-ratio: 1.05;
    }
  }

  /* STATS */
  .stats {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(56px, 7vw, 104px);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 18px;
    border-left: 1px solid rgba(244, 240, 232, 0.2);
  }
  .stat-value {
    font-family: var(--f-display);
    font-size: clamp(3rem, 6.4vw, 6rem);
    font-weight: 620;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    color: rgba(244, 240, 232, 0.72);
    max-width: 22ch;
  }
  @media (max-width: 860px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 48px;
    }
  }

  /* SERVICES */
  .services {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 32px);
  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--radius);
    background: var(--paper-2);
    transition:
      background 0.4s var(--ease),
      color 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .service:hover {
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-6px);
  }
  .service:hover .muted {
    color: rgba(244, 240, 232, 0.7);
  }
  .service-no {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }
  .service .h3 {
    margin-top: clamp(24px, 4vw, 64px);
  }
  .service ul {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .service:hover ul {
    border-color: rgba(244, 240, 232, 0.2);
  }
  .service li {
    padding-block: 6px;
  }
  .service li::before {
    content: '— ';
    color: var(--accent);
  }
  @media (max-width: 1060px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .services {
      grid-template-columns: 1fr;
    }
  }

  /* PROCESS */
  .process-sec {
    padding-top: 0;
  }
  .process {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    counter-reset: step;
  }
  .process li {
    position: relative;
    padding: 28px 22px 0 0;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .process li::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
  }
  .p-no {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .process {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .process li {
      border-top: 0;
      border-left: 2px solid var(--ink);
      padding: 0 0 32px 28px;
    }
    .process li::before {
      top: 0;
      left: -8px;
    }
  }

  /* ABOUT */
  .about {
    background: var(--paper-2);
  }
  .about-media {
    grid-column: 1 / span 4;
    position: sticky;
    top: 96px;
    align-self: start;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .about-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .about-mono {
    aspect-ratio: 4 / 5;
    background: var(--accent);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(5rem, 12vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  .about-mono .serif {
    padding-left: 0.3em;
  }
  .about-body {
    grid-column: 6 / span 7;
  }
  .about-text {
    margin-top: 28px;
  }
  .sub {
    margin-top: 56px;
    margin-bottom: 8px;
  }
  .list li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 4px 20px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  .list-date {
    font-size: 14px;
    color: var(--muted);
    padding-top: 2px;
  }
  .list-meta {
    grid-column: 2;
    font-size: 14px;
  }
